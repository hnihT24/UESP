--[[
    UESP - Maximum Performance Edition (Complete Fixed Version)
    Key Improvements:
    - Single persistent RaycastParams (Zero GC allocation overhead)
    - Staggered player updates spread across rendering frames (Zero CPU spikes)
    - Throttled wall-visibility raycasts (Every 0.4s per player)
    - Event-indexed part references with robust respawn re-indexing (Zero tree searching)
]]

local Players = game:GetService("Players")
local StarterGui = game:GetService("StarterGui")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local LocalPlayer = Players.LocalPlayer
if not LocalPlayer then
    error("UESP must run from a LocalScript on the client.")
end

-- =========================
-- Configuration
-- =========================

local Config = {
    UpdateInterval = 0.15,            -- Base update rate (seconds)
    RaycastInterval = 0.40,           -- Wall visibility update rate (seconds)
    MaxDistance = 0,                  -- 0 = Unlimited

    ShowBoxes = true,
    ShowNames = true,
    ShowHighlights = true,
    ShowDistance = true,
    ShowThroughWalls = true,

    BoxTransparency = 0.90,
    BoxSize = Vector3.new(1.3, 2.2, 1.3),
    HighlightFillTransparency = 0.90,
    HighlightOutlineTransparency = 0.60,

    NameTextSize = 10,
    NameTagHeight = 40,
    NeutralColor = Color3.fromRGB(235, 235, 235),

    OccludedFade = 0.40,
    OccludedTint = Color3.fromRGB(170, 170, 170),
}

-- =========================
-- Runtime State & Caching
-- =========================

local ESPEnabled = true
local NameESPEnabled = true
local ESPMode = 2
local Running = true

local PlayerStates = {}
local GlobalConnections = {}

-- Single reused RaycastParams instance to prevent Garbage Collection allocations
local SharedRaycastParams = RaycastParams.new()
SharedRaycastParams.FilterType = Enum.RaycastFilterType.Exclude
SharedRaycastParams.IgnoreWater = true

local BOX_NAME = "UESP_Client_Box_v1"
local NAME_GUI_NAME = "UESP_Client_NameTag_v1"
local NAME_LABEL_NAME = "UESP_Client_NameLabel_v1"
local HIGHLIGHT_NAME = "UESP_Client_Highlight_v1"

-- =========================
-- Utility Functions
-- =========================

local function AddConnection(connection)
    table.insert(GlobalConnections, connection)
    return connection
end

local function DisconnectAll(connections)
    for _, connection in ipairs(connections) do
        if connection and connection.Connected then
            connection:Disconnect()
        end
    end
    table.clear(connections)
end

local function Notify(title, message, duration)
    task.spawn(function()
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = title,
                Text = message,
                Duration = duration or 3,
            })
        end)
    end)
end

local function GetModeText()
    if ESPMode == 1 then return "Username"
    elseif ESPMode == 2 then return "DisplayName"
    else return "Both" end
end

local function GetPlayerColor(player)
    if not player.Neutral and player.Team then
        return player.Team.TeamColor.Color
    end
    return Config.NeutralColor
end

local function GetOrCreate(parent, name, className)
    local existing = parent:FindFirstChild(name)
    if existing and existing:IsA(className) then
        return existing
    end
    local instance = Instance.new(className)
    instance.Name = name
    instance.Parent = parent
    return instance
end

local function DestroyInstance(instance)
    if instance then
        pcall(function() instance:Destroy() end)
    end
end

local function DestroyVisuals(state)
    DestroyInstance(state.box)
    DestroyInstance(state.nameGui)
    DestroyInstance(state.highlight)
    state.box = nil
    state.boxRoot = nil
    state.nameGui = nil
    state.nameLabel = nil
    state.nameHead = nil
    state.highlight = nil
end

-- =========================
-- Character Indexing
-- =========================

local function IndexCharacterParts(character)
    if not character then return nil, nil, nil end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local rootPart = (humanoid and humanoid.RootPart) 
        or character:FindFirstChild("HumanoidRootPart")
        or character:FindFirstChild("Torso")
        or character:FindFirstChild("LowerTorso")
        or character.PrimaryPart

    local headPart = character:FindFirstChild("Head") or rootPart

    return rootPart, headPart, humanoid
end

-- =========================
-- Optimized Occlusion Test
-- =========================

local function CheckOcclusionThrottled(targetCharacter, targetPart, state, now)
    if now - state.lastOcclusionCheck < Config.RaycastInterval then
        return state.isOccluded
    end

    state.lastOcclusionCheck = now
    local camera = workspace.CurrentCamera
    local localCharacter = LocalPlayer.Character

    if not camera or not targetCharacter or not targetPart then
        state.isOccluded = false
        return false
    end

    local origin = camera.CFrame.Position
    local direction = targetPart.Position - origin

    if direction.Magnitude <= 0.001 then
        state.isOccluded = false
        return false
    end

    SharedRaycastParams.FilterDescendantsInstances = { localCharacter, targetCharacter }
    
    local result = workspace:Raycast(origin, direction, SharedRaycastParams)
    state.isOccluded = (result ~= nil)
    return state.isOccluded
end

-- =========================
-- Player Update Logic
-- =========================

local function UpdatePlayer(player, state, localRoot, now)
    local character = player.Character

    if state.character ~= character then
        DestroyVisuals(state)
        state.character = character
        state.rootPart, state.headPart, state.humanoid = IndexCharacterParts(character)
    end

    if not character or not character.Parent then
        DestroyVisuals(state)
        return
    end

    local humanoid = state.humanoid
    if humanoid and humanoid.Health <= 0 then
        DestroyVisuals(state)
        return
    end

    local rootPart = state.rootPart
    if not rootPart or not rootPart.Parent then
        state.rootPart, state.headPart, state.humanoid = IndexCharacterParts(character)
        rootPart = state.rootPart
        if not rootPart then
            DestroyVisuals(state)
            return
        end
    end

    local distance = nil
    if localRoot and localRoot.Parent then
        distance = (localRoot.Position - rootPart.Position).Magnitude
    end

    if distance and Config.MaxDistance > 0 and distance > Config.MaxDistance then
        DestroyVisuals(state)
        return
    end

    local targetPart = state.headPart or rootPart
    local occluded = CheckOcclusionThrottled(character, targetPart, state, now)
    local teamColor = GetPlayerColor(player)

    local espColor = teamColor
    if occluded then
        espColor = teamColor:Lerp(Config.OccludedTint, Config.OccludedFade)
    end

    -- 1. Box Adornment
    if Config.ShowBoxes then
        if not state.box or state.boxRoot ~= rootPart then
            DestroyInstance(state.box)
            state.box = GetOrCreate(rootPart, BOX_NAME, "BoxHandleAdornment")
            state.boxRoot = rootPart
        end
        local box = state.box
        box.Adornee = rootPart
        box.AlwaysOnTop = Config.ShowThroughWalls
        box.ZIndex = 5
        box.Transparency = Config.BoxTransparency
        box.Size = Config.BoxSize
        box.CFrame = CFrame.new()
        box.Color3 = espColor
        box.Visible = true
    else
        DestroyInstance(state.box)
        state.box = nil
    end

    -- 2. Highlight
    if Config.ShowHighlights then
        if not state.highlight then
            state.highlight = GetOrCreate(character, HIGHLIGHT_NAME, "Highlight")
        end
        local highlight = state.highlight
        highlight.Adornee = character
        highlight.DepthMode = Config.ShowThroughWalls and Enum.HighlightDepthMode.AlwaysOnTop or Enum.HighlightDepthMode.Occluded
        highlight.FillTransparency = Config.HighlightFillTransparency
        highlight.OutlineTransparency = Config.HighlightOutlineTransparency
        highlight.FillColor = espColor
        highlight.OutlineColor = occluded and teamColor:Lerp(Config.OccludedTint, Config.OccludedFade) or Color3.new(1, 1, 1)
        highlight.Enabled = true
    else
        DestroyInstance(state.highlight)
        state.highlight = nil
    end

    -- 3. Name Tag
    if Config.ShowNames and NameESPEnabled then
        if not state.nameGui or state.nameHead ~= targetPart then
            DestroyInstance(state.nameGui)
            state.nameGui = GetOrCreate(targetPart, NAME_GUI_NAME, "BillboardGui")
            state.nameLabel = GetOrCreate(state.nameGui, NAME_LABEL_NAME, "TextLabel")
            state.nameHead = targetPart
        end

        local gui = state.nameGui
        local label = state.nameLabel

        gui.Adornee = targetPart
        gui.AlwaysOnTop = Config.ShowThroughWalls
        gui.LightInfluence = 0
        gui.MaxDistance = Config.MaxDistance
        gui.Size = UDim2.fromOffset(180, Config.NameTagHeight)
        gui.StudsOffset = Vector3.new(0, math.max((targetPart.Size.Y * 0.5) + 0.75, 1.5), 0)
        gui.Enabled = true

        label.BackgroundTransparency = 1
        label.BorderSizePixel = 0
        label.Size = UDim2.fromScale(1, 1)
        label.Font = Enum.Font.GothamSemibold
        label.TextSize = Config.NameTextSize
        label.TextXAlignment = Enum.TextXAlignment.Center
        label.TextYAlignment = Enum.TextYAlignment.Center
        label.TextStrokeColor3 = Color3.new(0, 0, 0)
        label.TextStrokeTransparency = 0.2
        label.TextColor3 = espColor

        local displayText = (ESPMode == 1 and player.Name) 
            or (ESPMode == 2 and player.DisplayName) 
            or string.format("%s (%s)", player.DisplayName, player.Name)

        if Config.ShowDistance and distance then
            displayText = string.format("%s [%d studs]", displayText, math.floor(distance + 0.5))
        end

        if label.Text ~= displayText then
            label.Text = displayText
        end
    else
        DestroyInstance(state.nameGui)
        state.nameGui = nil
        state.nameLabel = nil
    end
end

-- =========================
-- Staggered Multi-Frame Execution Loop
-- =========================

local function TrackPlayer(player)
    if player == LocalPlayer or PlayerStates[player] then return end

    local state = {
        character = nil,
        rootPart = nil,
        headPart = nil,
        humanoid = nil,
        boxRoot = nil,
        box = nil,
        nameHead = nil,
        nameGui = nil,
        nameLabel = nil,
        highlight = nil,
        lastOcclusionCheck = 0,
        isOccluded = false,
        connections = {},
    }

    PlayerStates[player] = state

    table.insert(state.connections, player.CharacterAdded:Connect(function(char)
        DestroyVisuals(state)
        state.character = char
        state.rootPart, state.headPart, state.humanoid = IndexCharacterParts(char)
    end))

    table.insert(state.connections, player.CharacterRemoving:Connect(function()
        DestroyVisuals(state)
        state.character = nil
    end))
end

local function RemovePlayer(player)
    local state = PlayerStates[player]
    if not state then return end
    DisconnectAll(state.connections)
    DestroyVisuals(state)
    PlayerStates[player] = nil
end

-- Initialize current players
for _, p in ipairs(Players:GetPlayers()) do TrackPlayer(p) end
AddConnection(Players.PlayerAdded:Connect(TrackPlayer))
AddConnection(Players.PlayerRemoving:Connect(RemovePlayer))

-- Input Bindings
AddConnection(UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or UserInputService:GetFocusedTextBox() then return end

    if input.KeyCode == Enum.KeyCode.RightBracket then
        ESPEnabled = not ESPEnabled
        if not ESPEnabled then
            for _, s in pairs(PlayerStates) do DestroyVisuals(s) end
        end
        Notify("UESP", ESPEnabled and "ESP Enabled" or "ESP Disabled")
    elseif input.KeyCode == Enum.KeyCode.LeftBracket then
        ESPMode = (ESPMode % 3) + 1
        Notify("UESP", "Name mode: " .. GetModeText())
    elseif input.KeyCode == Enum.KeyCode.Semicolon then
        NameESPEnabled = not NameESPEnabled
        if not NameESPEnabled then
            for _, s in pairs(PlayerStates) do
                DestroyInstance(s.nameGui)
                s.nameGui = nil
            end
        end
        Notify("UESP", NameESPEnabled and "Name ESP Enabled" or "Name ESP Disabled")
    end
end))

-- Distributed update loop with fixed character re-verification
task.spawn(function()
    while Running do
        if ESPEnabled then
            local now = os.clock()
            local localCharacter = LocalPlayer.Character
            local localRoot = localCharacter and (localCharacter:FindFirstChild("HumanoidRootPart") or localCharacter.PrimaryPart) or nil

            local playerList = {}
            for player, state in pairs(PlayerStates) do
                if player.Parent == Players then
                    table.insert(playerList, { player = player, state = state })
                end
            end

            local batchSize = 5
            for i = 1, #playerList do
                local entry = playerList[i]
                local char = entry.player.Character
                if entry.state.character ~= char then
                    DestroyVisuals(entry.state)
                    entry.state.character = char
                    entry.state.rootPart, entry.state.headPart, entry.state.humanoid = IndexCharacterParts(char)
                end

                pcall(UpdatePlayer, entry.player, entry.state, localRoot, now)

                if i % batchSize == 0 then
                    RunService.Heartbeat:Wait()
                end
            end
        end

        task.wait(Config.UpdateInterval)
    end
end)

Notify("UESP", "Author: SynX2025", 3)
